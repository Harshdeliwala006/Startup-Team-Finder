
@{
    ViewBag.Title = "Forgot Password";
}

<style>
    body {
        background-color: #F3F3F3;
    }

    .forgot-page {
        min-height: 85vh;
        padding: 65px 15px;
        background: linear-gradient(135deg, #F3F3F3, #E0CBD1);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .forgot-card {
        background: #FFFFFF;
        padding: 40px 35px;
        border-radius: 18px;
        border: 1px solid #E0CBD1;
        box-shadow: 0 10px 30px rgba(67, 67, 111, 0.12);
        max-width: 450px;
        width: 100%;
    }

    .forgot-icon {
        width: 75px;
        height: 75px;
        background: #E2AAC3;
        color: #43436F;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin: 0 auto 20px;
    }

    .forgot-card h2 {
        color: #43436F;
        font-weight: 700;
        text-align: center;
        margin-bottom: 12px;
    }

    .forgot-description {
        color: #777;
        text-align: center;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 30px;
    }

    .forgot-card label {
        color: #43436F;
        font-weight: 600;
        font-size:19px;
        margin-bottom: 9px;
    }

    .forgot-card .form-control {
        height: 48px;
        width:100%;
        border: 1px solid #E0CBD1;
        border-radius: 9px;
        padding: 10px 14px;
        background: #FDFBFC;
    }

        .forgot-card .form-control:focus {
            border-color: #B83846;
            box-shadow: 0 0 0 3px rgba(184, 56, 70, 0.12);
        }

    .reset-btn {
        width: 100%;
        background: #B83846;
        color: white;
        border: none;
        padding: 13px;
        border-radius: 9px;
        font-weight: 600;
        font-size: 16px;
        transition: 0.3s;
        margin-top: 10px;
    }

        .reset-btn:hover {
            background: #43436F;
            color: white;
            transform: translateY(-2px);
        }

    .back-login {
        text-align: center;
        margin-top: 25px;
    }

        .back-login a {
            color: #B83846;
            font-weight: 600;
            text-decoration: none;
        }

            .back-login a:hover {
                color: #43436F;
                text-decoration: underline;
            }

    @@media (max-width: 576px) {
        .forgot-page {
            padding: 35px 15px;
        }

        .forgot-card {
            padding: 30px 22px;
        }
    }
</style>

<div class="forgot-page">

    <div class="forgot-card">

        <div class="forgot-icon">
            &#128274;
        </div>

        <h2>Forgot Password?</h2>

        <p class="forgot-description">
            Don't worry! It happens. Enter your registered
            email address below to request a password reset.
        </p>

        <form method="post" action="@Url.Action("ForgotPassword", "Account")">

            @Html.AntiForgeryToken()

            <div class="mb-4">

                <label class="form-label">
                    Email Address
                </label>

                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="Enter your registered email"
                       required />

            </div>

            <button type="submit" class="reset-btn">
                Send Reset Request
            </button>

        </form>

        <div class="back-login">
            <a href="@Url.Action("Login", "Account")">
                &#8592; Back to Login
            </a>
        </div>

    </div>

</div>
