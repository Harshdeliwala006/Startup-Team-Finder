@model IEnumerable<demostartupfinder.Models.User>

@{
    ViewBag.Title = "Find Teammates";
}

<style>
    :root {
        --off-white: #F3F3F3;
        --dust-pink: #E0CBD1;
        --pastel-pink: #E2AAC3;
        --berry-red: #B83846;
        --slate-navy: #43436F;
    }

    body {
        background: var(--off-white);
    }

    .teammates-header {
        background: linear-gradient(135deg, var(--slate-navy), #65658E);
        color: white;
        padding: 55px 20px;
        margin-bottom: 40px;
        border-radius: 0 0 30px 30px;
    }

        .teammates-header h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .teammates-header p {
            font-size: 16px;
            opacity: 0.9;
            margin-bottom: 0;
        }

    .teammates-container {
        max-width: 1150px;
        margin: auto;
        padding-bottom: 55px;
    }

    /* Search Section */

    .search-card {
        background: white;
        border: 1px solid var(--dust-pink);
        border-radius: 17px;
        padding: 25px;
        margin-bottom: 35px;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.06);
    }

    .search-title {
        color: var(--slate-navy);
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .search-input {
        height: 48px;
        border: 1px solid var(--dust-pink);
        border-radius: 9px;
        padding: 10px 15px;
        box-shadow: none !important;
    }

        .search-input:focus {
            border-color: var(--berry-red);
        }

    .btn-search {
        height: 48px;
        background: var(--berry-red);
        color: white;
        border: none;
        border-radius: 9px;
        font-weight: 600;
        transition: 0.2s ease;
    }

        .btn-search:hover {
            background: #962D39;
            color: white;
        }

    .btn-clear {
        display: inline-block;
        margin-top: 12px;
        color: var(--slate-navy);
        font-size: 13px;
        text-decoration: none;
    }

        .btn-clear:hover {
            color: var(--berry-red);
            text-decoration: underline;
        }

    /* Results */

    .results-heading {
        color: var(--slate-navy);
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 22px;
    }

    .results-count {
        color: var(--berry-red);
    }

    /* Teammate Cards */

    .teammate-card {
        background: white;
        border: 1px solid var(--dust-pink);
        border-radius: 18px;
        height: 100%;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .teammate-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(67, 67, 111, 0.13);
        }

    .card-top {
        height: 8px;
        background: linear-gradient(90deg, var(--berry-red), var(--pastel-pink));
    }

    .teammate-card-body {
        padding: 25px;
        text-align: center;
    }

    .teammate-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--pastel-pink), #F5DCE7);
        border: 4px solid white;
        box-shadow: 0 4px 15px rgba(67, 67, 111, 0.13);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 43px;
        margin: 5px auto 18px;
    }

    .teammate-name {
        color: var(--slate-navy);
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 9px;
        overflow-wrap: anywhere;
    }

    .teammate-location {
        color: #888;
        font-size: 13px;
        margin-bottom: 17px;
    }

    .teammate-bio {
        background: #FAF8F9;
        border-radius: 10px;
        padding: 13px;
        color: #666;
        font-size: 13px;
        line-height: 1.7;
        min-height: 75px;
        margin-bottom: 20px;
        overflow-wrap: anywhere;
    }

    .btn-profile {
        display: block;
        width: 100%;
        background: var(--slate-navy);
        color: white;
        padding: 11px 15px;
        border-radius: 9px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-profile:hover {
            background: var(--berry-red);
            color: white;
            text-decoration: none;
        }

    /* Empty State */

    .empty-state {
        background: white;
        border: 1px dashed var(--pastel-pink);
        border-radius: 20px;
        padding: 55px 20px;
        text-align: center;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.05);
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-state h4 {
        color: var(--slate-navy);
        font-weight: 700;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #777;
        margin-bottom: 0;
    }

    @@media (max-width: 767px) {
        .teammates-header {
            padding: 40px 15px;
        }

            .teammates-header h1 {
                font-size: 28px;
            }

        .search-card {
            padding: 20px;
        }

        .teammate-card-body {
            padding: 20px;
        }
    }
</style>

<!-- Header -->

<div class="teammates-header text-center">
    <div class="container">
        <h1>👥 Find Teammates</h1>
        <p>Connect with talented people who have the skills you need.</p>
    </div>
</div>

<div class="container teammates-container">

    <!-- Search Section -->

    <div class="search-card">

        <h4 class="search-title">
            🔍 Search Teammates
        </h4>

        @using (Html.BeginForm("Find", "Teammate", FormMethod.Get))
        {
            <div class="row g-2">

                <div class="col-md-10">

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control search-input"
                           placeholder="Search by name, skill, location or bio..." />

                </div>

                <div class="col-md-2">

                    <button type="submit" class="btn btn-search w-100">
                        🔍 Search
                    </button>

                </div>

            </div>

            if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.Search)))
            {
                <a href="@Url.Action("Find", "Teammate")"
                   class="btn-clear">
                    ✕ Clear Search
                </a>
            }
        }

    </div>

    <!-- Teammate Results -->

    @if (Model != null && Model.Any())
    {
        <h4 class="results-heading">
            ✨ Discover Teammates
            <span class="results-count">(@Model.Count())</span>
        </h4>

        <div class="row">

            @foreach (var user in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="teammate-card">

                        <div class="card-top"></div>

                        <div class="teammate-card-body">

                            <div class="teammate-avatar">
                                👤
                            </div>

                            <h4 class="teammate-name">
                                @user.Name
                            </h4>

                            <p class="teammate-location">
                                📍 @(string.IsNullOrWhiteSpace(user.Location)
                                    ? "Location not specified"
                                    : user.Location)
                            </p>

                            <div class="teammate-bio">
                                @(string.IsNullOrWhiteSpace(user.Bio)
                                    ? "No bio available."
                                    : user.Bio)
                            </div>

                            <a href="@Url.Action(
                                "Details",
                                "Teammate",
                                new { id = user.Id })"
                               class="btn-profile">
                                👁 View Profile →
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <div class="empty-icon">
                🔎
            </div>

            <h4>No Teammates Found</h4>

            <p>
                Try searching with another name, skill or location.
                New teammates will appear here when they register.
            </p>

        </div>
    }

</div>