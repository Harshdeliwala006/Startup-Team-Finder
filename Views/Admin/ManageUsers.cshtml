
@model IEnumerable<demostartupfinder.Models.User>

@{
    ViewBag.Title = "Manage Users";
}

<style>
    body {
        background: #F3F3F3;
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #34344F;
    }

    /* HEADER */
    .users-header {
        background: linear-gradient(135deg, #43436F, #292947);
        color: #FFFFFF;
        padding: 40px 20px;
        border-radius: 0 0 25px 25px;
        margin-bottom: 30px;
        box-shadow: 0 6px 20px rgba(67, 67, 111, 0.15);
    }

        .users-header h1 {
            color: #FFFFFF;
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .users-header p {
            color: #E2AAC3;
            font-size: 16px;
            margin: 0;
        }

    /* MAIN CONTAINER */
    .users-container {
        padding-bottom: 40px;
    }

    /* TABLE CARD */
    .users-card {
        background: #FFFFFF;
        border: 1px solid #E0CBD1;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.07);
    }

    /* TABLE TITLE */
    .users-title {
        color: #43436F;
        font-size: 22px;
        font-weight: 700;
        margin: 0;
    }

    .users-count {
        background: #B83846;
        color: #FFFFFF;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    /* TABLE */
    .users-table {
        margin-bottom: 0;
        color: #34344F;
        vertical-align: middle;
        white-space: nowrap;
    }

        .users-table thead th {
            background: #43436F;
            color: #FFFFFF;
            font-size: 13px;
            font-weight: 650;
            padding: 15px 12px;
            border: none;
        }

            .users-table thead th:first-child {
                border-radius: 9px 0 0 0;
            }

            .users-table thead th:last-child {
                border-radius: 0 9px 0 0;
            }

        .users-table tbody td {
            padding: 15px 12px;
            font-size: 13px;
            color: #45455E;
            border-bottom: 1px solid #F0E5E9;
        }

        .users-table tbody tr {
            transition: background 0.2s ease;
        }

            .users-table tbody tr:hover {
                background: #FBF4F7;
            }

    .user-id {
        color: #77778F;
        font-weight: 600;
    }

    .user-name {
        color: #43436F;
        font-weight: 700;
    }

    .user-email {
        color: #55556F;
    }

    .user-location {
        color: #77778F;
    }

    /* ROLE BADGES */
    .role-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .admin-badge {
        background: #F8E3E6;
        color: #B83846;
    }

    .user-badge {
        background: #E8E7F1;
        color: #43436F;
    }

    /* DELETE BUTTON */
    .delete-btn {
        background: #B83846;
        color: #FFFFFF;
        border: none;
        border-radius: 7px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        transition: 0.25s;
    }

        .delete-btn:hover {
            background: #982D39;
            color: #FFFFFF;
            transform: translateY(-2px);
        }

    .protected-text {
        color: #77778F;
        font-size: 12px;
        font-weight: 600;
    }

    /* BACK BUTTON */
    .back-btn {
        display: inline-block;
        background: #43436F;
        color: #FFFFFF;
        border: none;
        border-radius: 9px;
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s;
    }

        .back-btn:hover {
            background: #292947;
            color: #FFFFFF;
            transform: translateY(-2px);
        }

    /* ALERTS */
    .alert {
        border: none;
        border-radius: 10px;
        font-size: 14px;
    }

    .alert-success {
        color: #245B3B;
    }

    .alert-danger {
        color: #842029;
    }

    /* EMPTY STATE */
    .empty-users {
        text-align: center;
        padding: 35px;
        color: #77778F;
        font-size: 14px;
    }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .users-header {
            padding: 30px 15px;
        }

            .users-header h1 {
                font-size: 25px;
            }

        .users-card {
            padding: 15px;
        }

        .users-title {
            font-size: 18px;
        }

        .users-table thead th,
        .users-table tbody td {
            padding: 11px 9px;
            font-size: 12px;
        }
    }
</style>

<!-- HEADER -->
<div class="users-header text-center">
    <div class="container">
        <h1>👥 Manage Users</h1>
        <p>View, monitor and manage registered users</p>
    </div>
</div>

<div class="container users-container">

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            ✓ @TempData["Success"]
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            ⚠ @TempData["Error"]
        </div>
    }

    <!-- USERS TABLE CARD -->
    <div class="users-card">

        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-3 mb-4">

            <h4 class="users-title">
                Registered Users
            </h4>

            <span class="users-count">
                👥 @Model.Count() Users
            </span>

        </div>

        <div class="table-responsive">

            <table class="table users-table">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Location</th>
                        <th>Role</th>
                        <th>Created</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>

                                <td class="user-id">
                                    #@user.Id
                                </td>

                                <td class="user-name">
                                    @user.Name
                                </td>

                                <td class="user-email">
                                    @user.Email
                                </td>

                                <td class="user-location">
                                    @(string.IsNullOrEmpty(user.Location)
                                        ? "-"
                                        : user.Location)
                                </td>

                                <td>
                                    @if (user.Role == "Admin")
                                    {
                                        <span class="role-badge admin-badge">
                                            ● Admin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="role-badge user-badge">
                                            ● User
                                        </span>
                                    }
                                </td>

                                <td>
                                    @user.CreatedAt.ToString("dd-MM-yyyy")
                                </td>

                                <td>
                                    @if (user.Role != "Admin")
                                    {
                                        <form method="post"
                                              action="@Url.Action("DeleteUser", "Admin")"
                                              onsubmit="return confirm('Are you sure you want to delete this user?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button type="submit"
                                                    class="delete-btn">
                                                🗑 Delete
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="protected-text">
                                            🔒 Protected
                                        </span>
                                    }
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-users">
                                👥 No registered users found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- BACK BUTTON -->
    <div class="mt-4 mb-4">

        <a href="@Url.Action("Dashboard", "Admin")"
           class="back-btn">
            ← Back to Admin Dashboard
        </a>

    </div>

</div>
