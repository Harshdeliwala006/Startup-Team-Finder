@model IEnumerable<demostartupfinder.Models.Idea>

@{
    ViewBag.Title = "My Ideas";
}

<style>
    :root {
        --off-white: #F3F3F3;
        --dust-pink: #E0CBD1;
        --pastel-pink: #E2AAC3;
        --berry-red: #B83846;
        --slate-navy: #43436F;
    }

    body {
        background: var(--off-white);
    }

    .ideas-hero {
        background: linear-gradient(135deg, #43436F, #65658E);
        color: white;
        padding: 50px 20px;
        margin-bottom: 40px;
    }

        .ideas-hero h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .ideas-hero p {
            color: var(--pastel-pink);
            font-size: 17px;
            margin: 0;
        }

    .ideas-container {
        max-width: 1200px;
        margin: 0 auto 60px;
    }

    .ideas-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 15px;
    }

        .ideas-toolbar h3 {
            color: var(--slate-navy);
            font-size: 23px;
            font-weight: 700;
            margin: 0;
        }

    .create-idea-btn {
        background: var(--berry-red);
        color: white;
        padding: 12px 22px;
        border-radius: 9px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.25s;
    }

        .create-idea-btn:hover {
            background: #982D3A;
            color: white;
            transform: translateY(-2px);
        }

    .idea-card {
        background: white;
        border: 1px solid var(--dust-pink);
        border-radius: 15px;
        padding: 25px;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.06);
        transition: 0.3s;
    }

        .idea-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(67, 67, 111, 0.13);
            border-color: var(--pastel-pink);
        }

    .idea-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
        gap: 10px;
    }

    .category-badge {
        background: #F8E8EF;
        color: var(--berry-red);
        padding: 7px 13px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 700;
    }

    .idea-icon {
        background: #F3F3F8;
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .idea-title {
        color: var(--slate-navy);
        font-size: 21px;
        font-weight: 700;
        margin-bottom: 12px;
        overflow-wrap: anywhere;
    }

    .idea-description {
        color: #6F6F85;
        font-size: 14px;
        line-height: 1.7;
        margin-bottom: 20px;
        overflow-wrap: anywhere;
    }

    .idea-info {
        background: #FAF6F8;
        border-radius: 9px;
        padding: 13px;
        margin-bottom: 18px;
    }

    .info-label {
        color: var(--slate-navy);
        font-size: 12px;
        font-weight: 700;
        display: block;
        margin-bottom: 5px;
    }

    .info-value {
        color: #77778F;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    .team-info {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--slate-navy);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .idea-actions {
        display: flex;
        gap: 8px;
        margin-top: auto;
        padding-top: 15px;
        border-top: 1px solid #F0E5E9;
    }

    .action-btn {
        flex: 1;
        text-align: center;
        padding: 9px 5px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s;
    }

    .view-btn {
        background: var(--slate-navy);
        color: white;
    }

        .view-btn:hover {
            background: #303052;
            color: white;
        }

    .edit-btn {
        background: #F8E8EF;
        color: var(--berry-red);
        border: 1px solid var(--pastel-pink);
    }

        .edit-btn:hover {
            background: var(--pastel-pink);
            color: var(--slate-navy);
        }

    .delete-btn {
        background: #FCEBED;
        color: var(--berry-red);
        border: 1px solid #EBC1C6;
    }

        .delete-btn:hover {
            background: var(--berry-red);
            color: white;
        }

    .empty-state {
        background: white;
        border: 1px dashed var(--pastel-pink);
        border-radius: 16px;
        text-align: center;
        padding: 55px 25px;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.05);
    }

    .empty-icon {
        font-size: 55px;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        color: var(--slate-navy);
        font-weight: 700;
        margin-bottom: 10px;
    }

    .empty-state p {
        color: #77778F;
        margin-bottom: 22px;
    }

    .alert {
        border-radius: 9px;
        margin-bottom: 25px;
    }

    @@media (max-width: 576px) {
        .ideas-hero h1 {
            font-size: 28px;
        }

        .ideas-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .create-idea-btn {
            text-align: center;
        }

        .idea-card {
            padding: 20px;
        }

        .idea-actions {
            gap: 6px;
        }
    }
</style>

<!-- Hero Section -->
