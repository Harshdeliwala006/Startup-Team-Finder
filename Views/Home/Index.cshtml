
@{
    ViewBag.Title = "Home";
}

<style>
    body {
        background: #F3F3F3;
        font-family: 'Segoe UI', Arial, sans-serif;
        color: #34344F;
    }

    /* ================= HERO SECTION ================= */

    .hero {
        background: linear-gradient(135deg, #43436F, #292947);
        color: #FFFFFF;
        padding: 85px 0;
        border-radius: 0 0 35px 35px;
        overflow: hidden;
        position: relative;
        box-shadow: 0 8px 25px rgba(67, 67, 111, 0.15);
    }

        .hero h1 {
            color: #FFFFFF;
            font-size: 46px;
            font-weight: 800;
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .hero p {
            color: #E2AAC3;
            font-size: 17px;
            line-height: 1.8;
            max-width: 600px;
        }

    .hero-rocket {
        font-size: 145px;
        display: inline-block;
        filter: drop-shadow(0 10px 15px rgba(0,0,0,0.2));
        animation: floatRocket 3s ease-in-out infinite;
    }

    @@keyframes floatRocket {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-13px);
        }
    }

    /* HERO BUTTONS */
    .hero-primary-btn {
        background: #FFFFFF;
        color: #43436F;
        border: 2px solid #FFFFFF;
        border-radius: 9px;
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
    }

        .hero-primary-btn:hover {
            background: #E2AAC3;
            color: #43436F;
            border-color: #E2AAC3;
            transform: translateY(-3px);
        }

    .hero-outline-btn {
        background: transparent;
        color: #FFFFFF;
        border: 2px solid #E2AAC3;
        border-radius: 9px;
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none;
        display: inline-block;
        transition: 0.3s;
    }

        .hero-outline-btn:hover {
            background: #E2AAC3;
            color: #43436F;
            transform: translateY(-3px);
        }

    /* ================= SECTION HEADINGS ================= */

    .home-section {
        padding-top: 65px;
        padding-bottom: 30px;
    }

    .section-heading {
        color: #43436F;
        font-size: 30px;
        font-weight: 750;
        margin-bottom: 12px;
    }

    .section-description {
        color: #77778F;
        font-size: 15px;
        line-height: 1.7;
    }

    /* ================= FEATURE CARDS ================= */

    .feature-card {
        background: #FFFFFF;
        border: 1px solid #E0CBD1;
        border-radius: 17px;
        padding: 30px 24px;
        height: 100%;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.06);
        transition: all 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 26px rgba(67, 67, 111, 0.13);
            border-color: #E2AAC3;
        }

    .feature-icon {
        width: 68px;
        height: 68px;
        background: #F5E8ED;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
    }

    .feature-card h4 {
        color: #43436F;
        font-size: 19px;
        font-weight: 700;
        margin-top: 20px;
        margin-bottom: 12px;
    }

    .feature-card p {
        color: #77778F;
        font-size: 14px;
        line-height: 1.8;
        min-height: 75px;
    }

    .feature-btn {
        display: inline-block;
        background: #B83846;
        color: #FFFFFF;
        padding: 10px 17px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        transition: 0.3s;
    }

        .feature-btn:hover {
            background: #982D39;
            color: #FFFFFF;
            transform: translateY(-2px);
        }

    /* ================= HOW IT WORKS ================= */

    .steps-section {
        background: #FFFFFF;
        border: 1px solid #E0CBD1;
        border-radius: 20px;
        padding: 40px 25px;
        margin-top: 55px;
        margin-bottom: 60px;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.05);
    }

    .step-card {
        padding: 20px 12px;
        height: 100%;
        transition: 0.3s;
    }

        .step-card:hover {
            transform: translateY(-5px);
        }

    .step-number {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        border-radius: 18px;
        background: #F5E8ED;
        color: #B83846;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 800;
    }

    .step-card h5 {
        color: #43436F;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .step-card p {
        color: #77778F;
        font-size: 13px;
        line-height: 1.7;
    }

    /* ================= BOTTOM BANNER ================= */

    .home-banner {
        background: linear-gradient(135deg, #43436F, #292947);
        padding: 40px 25px;
        border-radius: 20px;
        text-align: center;
        margin-bottom: 50px;
    }

        .home-banner h3 {
            color: #FFFFFF;
            font-size: 27px;
            font-weight: 750;
            margin-bottom: 12px;
        }

        .home-banner p {
            color: #E2AAC3;
            font-size: 15px;
            margin-bottom: 22px;
        }

    /* ================= RESPONSIVE ================= */

    @@media (max-width: 768px) {
        .hero {
            padding: 55px 20px;
            text-align: center;
        }

            .hero h1 {
                font-size: 33px;
            }

            .hero p {
                font-size: 15px;
                margin-left: auto;
                margin-right: auto;
            }

        .hero-rocket {
            font-size: 100px;
            margin-top: 35px;
        }

        .section-heading {
            font-size: 25px;
        }

        .feature-card {
            padding: 25px 20px;
        }

        .steps-section {
            padding: 30px 15px;
        }

        .home-banner h3 {
            font-size: 22px;
        }
    }

    @@media (max-width: 480px) {
        .hero h1 {
            font-size: 29px;
        }

        .hero-primary-btn,
        .hero-outline-btn {
            display: block;
            margin: 10px auto;
            width: 100%;
            max-width: 250px;
        }
    }
</style>


<!-- ================= HERO SECTION ================= -->

<section class="hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-7">

                <h1>
                    Find Your Perfect Startup Team 🚀
                </h1>

                <p>
                    Connect with entrepreneurs, students,
                    developers, designers and innovators
                    who are looking to build something amazing.
                    Turn your ideas into reality with the right people.
                </p>

                <div class="mt-4">

                    <a href="@Url.Action("Find", "Teammate")"
                       class="hero-primary-btn me-2">
                        👥 Find Teammates
                    </a>

                    <a href="@Url.Action("BrowseIdeas", "Idea")"
                       class="hero-outline-btn">
                        💡 Explore Ideas
                    </a>

                </div>

            </div>

            <div class="col-md-5 text-center">

                <div class="hero-rocket">
                    🚀
                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= FEATURES SECTION ================= -->

<section class="container home-section">

    <div class="text-center mb-5">

        <h2 class="section-heading">
            Everything You Need to Build a Team
        </h2>

        <p class="section-description">
            Discover talented people, explore innovative ideas
            and create something extraordinary together.
        </p>

    </div>

    <div class="row g-4">

        <!-- FEATURE 1 -->

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    👥
                </div>

                <h4>Find Teammates</h4>

                <p>
                    Search for people based on their skills,
                    location and interests. Discover the right
                    people for your next project.
                </p>

                <a href="@Url.Action("Find", "Teammate")"
                   class="feature-btn">
                    Find People →
                </a>

            </div>

        </div>


        <!-- FEATURE 2 -->

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    💡
                </div>

                <h4>Share Startup Ideas</h4>

                <p>
                    Publish your startup idea and connect
                    with people who are interested in
                    bringing your vision to life.
                </p>

                <a href="@Url.Action("CreateIdea", "Idea")"
                   class="feature-btn">
                    Create Idea →
                </a>

            </div>

        </div>


        <!-- FEATURE 3 -->

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">
                    🚀
                </div>

                <h4>Build Your Team</h4>

                <p>
                    Connect with teammates, collaborate
                    on projects and work together to
                    develop successful startups.
                </p>

                <a href="@Url.Action("MyTeams", "Team")"
                   class="feature-btn">
                    My Teams →
                </a>

            </div>

        </div>

    </div>

</section>


<!-- ================= HOW IT WORKS ================= -->

<section class="container">

    <div class="steps-section">

        <div class="text-center mb-5">

            <h2 class="section-heading">
                How It Works
            </h2>

            <p class="section-description">
                Four simple steps to start your startup journey.
            </p>

        </div>

        <div class="row text-center g-4">

            <!-- STEP 1 -->

            <div class="col-md-3 col-6">

                <div class="step-card">

                    <div class="step-number">01</div>

                    <h5>Create Profile</h5>

                    <p>
                        Showcase your skills,
                        experience and interests.
                    </p>

                </div>

            </div>


            <!-- STEP 2 -->

            <div class="col-md-3 col-6">

                <div class="step-card">

                    <div class="step-number">02</div>

                    <h5>Discover People</h5>

                    <p>
                        Find potential teammates
                        with complementary skills.
                    </p>

                </div>

            </div>


            <!-- STEP 3 -->

            <div class="col-md-3 col-6">

                <div class="step-card">

                    <div class="step-number">03</div>

                    <h5>Share Ideas</h5>

                    <p>
                        Publish your startup ideas
                        and explore opportunities.
                    </p>

                </div>

            </div>


            <!-- STEP 4 -->

            <div class="col-md-3 col-6">

                <div class="step-card">

                    <div class="step-number">04</div>

                    <h5>Build Together</h5>

                    <p>
                        Collaborate with your team
                        and bring ideas to life.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- ================= BOTTOM CALL TO ACTION ================= -->

<section class="container">

    <div class="home-banner">

        <h3>Ready to Build Something Amazing?</h3>

        <p>
            Your next great idea starts with the right team.
            Connect, collaborate and create today!
        </p>

        <a href="@Url.Action("Register", "Account")"
           class="hero-primary-btn">
            Get Started Today →
        </a>

    </div>

</section>
