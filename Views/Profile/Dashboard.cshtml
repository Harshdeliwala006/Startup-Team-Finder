
@{
    ViewBag.Title = "Dashboard";
}

<style>
    :root {
        --off-white: #F3F3F3;
        --dust-pink: #E0CBD1;
        --pastel-pink: #E2AAC3;
        --berry-red: #B83846;
        --slate-navy: #43436F;
    }

    body {
        background: var(--off-white);
    }

    /* Welcome Header */

    .dashboard-header {
        background: linear-gradient(135deg, #43436F, #666694);
        color: white;
        padding: 65px 0;
        margin-bottom: 45px;
        position: relative;
        overflow: hidden;
    }

        .dashboard-header::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255,255,255,0.07);
            right: 8%;
            top: -100px;
        }

        .dashboard-header h1 {
            font-size: 38px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .dashboard-header p {
            font-size: 17px;
            color: #F3F3F3;
            margin: 0;
        }

    .dashboard-label {
        display: inline-block;
        background: rgba(226,170,195,0.2);
        color: #F8DCE9;
        padding: 7px 16px;
        border-radius: 25px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 18px;
    }

    /* Dashboard Layout */

    .dashboard-container {
        max-width: 1150px;
        margin: auto;
        padding: 0 15px 60px;
    }

    .section-heading {
        color: var(--slate-navy);
        font-size: 25px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .section-description {
        color: #777;
        margin-bottom: 30px;
    }

    /* Feature Cards */

    .dashboard-card {
        background: white;
        border: 1px solid var(--dust-pink);
        border-radius: 17px;
        padding: 28px 25px;
        height: 50%;
        min-height: 265px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 5px 18px rgba(67,67,111,0.05);
        transition: all 0.3s ease;
    }

        .dashboard-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(67,67,111,0.13);
            border-color: var(--pastel-pink);
        }

    .card-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #F8E8EF;
        border-radius: 16px;
        font-size: 32px;
        margin-bottom: 20px;
    }

    .dashboard-card h4 {
        color: var(--slate-navy);
        font-weight: 700;
        font-size: 19px;
        margin-bottom: 10px;
    }

    .dashboard-card p {
        color: #777;
        font-size: 14px;
        line-height: 1.6;
        flex-grow: 1;
        margin-bottom: 22px;
    }

    .dashboard-btn {
        display: inline-block;
        width: fit-content;
        background: var(--berry-red);
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

        .dashboard-btn:hover {
            background: var(--slate-navy);
            color: white;
            text-decoration: none;
        }

    .dashboard-card:hover .card-icon {
        background: var(--pastel-pink);
    }

    /* Different icon backgrounds */

    .icon-blue {
        background: #E8E8F3;
    }

    .icon-red {
        background: #F9E5E7;
    }

    .icon-pink {
        background: #F8E8EF;
    }

    .icon-purple {
        background: #ECE9F5;
    }

    .icon-green {
        background: #E7F2EB;
    }

    /* Responsive */

    @@media (max-width: 768px) {
        .dashboard-header {
            padding: 45px 0;
        }

            .dashboard-header h1 {
                font-size: 29px;
            }

        .dashboard-card {
            min-height: 245px;
        }
    }

    @@media (max-width: 576px) {
        .dashboard-header h1 {
            font-size: 25px;
        }

        .section-heading {
            font-size: 22px;
        }
    }
</style>

<!-- Welcome Header -->

<div class="dashboard-header">
    <div class="container">

        <span class="dashboard-label">
            STARTUP TEAM FINDER
        </span>

        <h1>
            Welcome, @Session["UserName"] 👋
        </h1>

        <p>
            Manage your profile, discover talented people,
            develop ideas and build your dream team.
        </p>

    </div>
</div>

<!-- Dashboard Cards -->

<div class="dashboard-container">

    <h3 class="section-heading">
        Your Workspace
    </h3>

    <p class="section-description">
        Everything you need to manage your startup journey in one place.
    </p>

    <div class="row g-4">

        <!-- PROFILE -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-blue">👤</div>

                <h4>My Profile</h4>

                <p>
                    View and update your personal information,
                    bio and professional details.
                </p>

                <a href="@Url.Action("MyProfile", "Profile")"
                   class="dashboard-btn">
                    View Profile →
                </a>

            </div>
        </div>

        <!-- FIND TEAMMATES -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-purple">👥</div>

                <h4>Find Teammates</h4>

                <p>
                    Discover talented people and connect
                    with members who have useful skills.
                </p>

                <a href="@Url.Action("Find", "Teammate")"
                   class="dashboard-btn">
                    Find People →
                </a>

            </div>
        </div>

        <!-- CREATE IDEA -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-pink">💡</div>

                <h4>Create Idea</h4>

                <p>
                    Share your innovative startup idea
                    and find people to work with.
                </p>

                <a href="@Url.Action("CreateIdea", "Idea")"
                   class="dashboard-btn">
                    Create Idea →
                </a>

            </div>
        </div>

        <!-- MY IDEAS -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-red">📋</div>

                <h4>My Ideas</h4>

                <p>
                    View, edit and manage all your
                    published startup ideas.
                </p>

                <a href="@Url.Action("MyIdeas", "Idea")"
                   class="dashboard-btn">
                    My Ideas →
                </a>

            </div>
        </div>

        <!-- TEAMS -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-blue">🚀</div>

                <h4>My Teams</h4>

                <p>
                    Explore your teams, team members
                    and ongoing startup collaborations.
                </p>

                <a href="@Url.Action("MyTeams", "Team")"
                   class="dashboard-btn">
                    My Teams →
                </a>

            </div>
        </div>

        <!-- MESSAGES -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-green">💬</div>

                <h4>Messages</h4>

                <p>
                    Communicate with teammates and
                    discuss your startup projects.
                </p>

                <a href="@Url.Action("Messages", "Message")"
                   class="dashboard-btn">
                    Open Messages →
                </a>

            </div>
        </div>

        <!-- NOTIFICATIONS -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-pink">🔔</div>

                <h4>Notifications</h4>

                <p>
                    Stay informed about join requests,
                    team activities and important updates.
                </p>

                <a href="@Url.Action("Notifications", "Notification")"
                   class="dashboard-btn">
                    View Notifications →
                </a>

            </div>
        </div>

        <!-- SETTINGS -->

        <div class="col-lg-3 col-md-6">
            <div class="dashboard-card">

                <div class="card-icon icon-purple">⚙️</div>

                <h4>Settings</h4>

                <p>
                    Manage your account preferences
                    and personal settings.
                </p>

                <a href="@Url.Action("Settings", "Profile")"
                   class="dashboard-btn">
                    Manage Settings →
                </a>

            </div>
        </div>

    </div>

</div>
