
@model IEnumerable<demostartupfinder.Models.Skill>

@{
    ViewBag.Title = "My Skills";
}

<style>
    :root {
        --off-white: #F3F3F3;
        --dust-pink: #E0CBD1;
        --pastel-pink: #E2AAC3;
        --berry-red: #B83846;
        --slate-navy: #43436F;
    }

    body {
        background: var(--off-white);
    }

    /* Page Header */

    .skills-header {
        background: linear-gradient(135deg, #43436F, #666694);
        color: white;
        padding: 55px 20px;
        text-align: center;
        margin-bottom: 45px;
    }

        .skills-header h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .skills-header p {
            color: #F3F3F3;
            font-size: 16px;
            margin: 0;
        }

    .header-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    /* Main Container */

    .skills-container {
        max-width: 850px;
        margin: auto;
        padding: 0 15px 65px;
    }

    .skills-card {
        background: white;
        border: 1px solid var(--dust-pink);
        border-radius: 17px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 6px 20px rgba(67,67,111,0.06);
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 10px;
    }

    .section-icon {
        width: 48px;
        height: 48px;
        background: #F8E8EF;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .section-heading h4 {
        color: var(--slate-navy);
        font-size: 20px;
        font-weight: 700;
        margin: 0;
    }

    .section-description {
        color: #888;
        font-size: 13px;
        margin-bottom: 23px;
    }

    /* Add Skill Form */

    .skill-input {
        flex: 1;
        min-width: 0;
        padding: 13px 15px;
        border: 1px solid var(--dust-pink);
        border-radius: 9px;
        background: #FCFAFB;
        color: var(--slate-navy);
        font-size: 14px;
        outline: none;
        transition: 0.3s;
    }

        .skill-input:focus {
            border-color: var(--berry-red);
            background: white;
            box-shadow: 0 0 0 3px rgba(184,56,70,0.10);
        }

    .add-skill-form {
        display: flex;
        gap: 12px;
        margin-top: 20px;
    }

    .btn-add-skill {
        background: var(--berry-red);
        color: white;
        border: none;
        border-radius: 9px;
        padding: 12px 22px;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        transition: 0.3s;
    }

        .btn-add-skill:hover {
            background: var(--slate-navy);
            transform: translateY(-2px);
        }

    /* Skill List */

    .skills-list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        flex-wrap: wrap;
        gap: 10px;
    }

    .skill-count {
        background: #F8E8EF;
        color: var(--berry-red);
        padding: 7px 15px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .skill-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        background: #FCF9FB;
        border: 1px solid var(--dust-pink);
        border-radius: 11px;
        padding: 15px 18px;
        margin-bottom: 13px;
        transition: 0.3s;
    }

        .skill-item:hover {
            border-color: var(--pastel-pink);
            transform: translateX(4px);
            box-shadow: 0 4px 12px rgba(67,67,111,0.06);
        }

    .skill-info {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .skill-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: var(--pastel-pink);
        color: var(--slate-navy);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .skill-name {
        color: var(--slate-navy);
        font-size: 15px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .skill-badge {
        display: inline-block;
        background: #F8E8EF;
        color: var(--berry-red);
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    /* Delete Button */

    .btn-delete-skill {
        background: white;
        color: var(--berry-red);
        border: 1px solid var(--berry-red);
        border-radius: 8px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: 0.3s;
    }

        .btn-delete-skill:hover {
            background: var(--berry-red);
            color: white;
            text-decoration: none;
        }

    /* Empty State */

    .empty-skills {
        text-align: center;
        background: #FCF9FB;
        border: 1px dashed var(--dust-pink);
        border-radius: 13px;
        padding: 45px 20px;
    }

    .empty-icon {
        font-size: 48px;
        margin-bottom: 15px;
    }

    .empty-skills h5 {
        color: var(--slate-navy);
        font-weight: 700;
        margin-bottom: 10px;
    }

    .empty-skills p {
        color: #888;
        font-size: 14px;
        margin: 0;
    }

    /* Responsive */

    @@media (max-width: 576px) {
        .skills-header {
            padding: 40px 15px;
        }

            .skills-header h1 {
                font-size: 29px;
            }

        .skills-card {
            padding: 22px 17px;
        }

        .add-skill-form {
            flex-direction: column;
        }

        .btn-add-skill {
            width: 100%;
        }

        .skill-item {
            padding: 12px;
        }
    }
</style>

<!-- Page Header -->

<div class="skills-header">

    <div class="container">

        <div class="header-icon">⭐</div>

        <h1>My Skills</h1>

        <p>
            Showcase your abilities and help other founders discover you.
        </p>

    </div>

</div>

<!-- Skills Content -->

<div class="skills-container">

    <!-- Add New Skill -->

    <div class="skills-card">

        <div class="section-heading">

            <div class="section-icon">
                ➕
            </div>

            <h4>Add New Skill</h4>

        </div>

        <p class="section-description">
            Add your technical skills, creative abilities and expertise.
        </p>

        @using (Html.BeginForm(
            "AddSkill",
            "Profile",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="add-skill-form">

                <input type="text"
                       name="skillName"
                       class="skill-input"
                       placeholder="Example: React, Python, UI Design..."
                       maxlength="100"
                       required />

                <button type="submit" class="btn-add-skill">
                    + Add Skill
                </button>

            </div>
        }

    </div>

    <!-- Skills List -->

    <div class="skills-card">

        <div class="skills-list-header">

            <div class="section-heading mb-0">

                <div class="section-icon">
                    💼
                </div>

                <h4>My Skills</h4>

            </div>

            <span class="skill-count">
                @(Model == null ? 0 : Model.Count()) Skills Added
            </span>

        </div>

        @if (Model != null && Model.Any())
        {
            foreach (var skill in Model)
            {
                <div class="skill-item">

                    <div class="skill-info">

                        <div class="skill-icon">
                            ✦
                        </div>

                        <span class="skill-name">
                            @skill.SkillName
                        </span>

                        <span class="skill-badge">
                            SKILL
                        </span>

                    </div>

                    <a href="@Url.Action("DeleteSkill",
                             "Profile",
                             new { id = skill.Id })"
                       class="btn-delete-skill"
                       onclick="return confirm('Are you sure you want to delete this skill?');">

                        🗑 Delete

                    </a>

                </div>
            }
        }
        else
        {
            <div class="empty-skills">

                <div class="empty-icon">
                    🎯
                </div>

                <h5>No Skills Added Yet</h5>

                <p>
                    Start building your professional profile by
                    adding your first skill above.
                </p>

            </div>
        }

    </div>

</div>
