@model IEnumerable<demostartupfinder.Models.Team>

@{
    ViewBag.Title = "My Teams";
}

<style>
    :root {
        --off-white: #F3F3F3;
        --dust-pink: #E0CBD1;
        --pastel-pink: #E2AAC3;
        --berry-red: #B83846;
        --slate-navy: #43436F;
    }

    body {
        background: var(--off-white);
    }

    .teams-header {
        background: linear-gradient(135deg, var(--slate-navy), #65658E);
        color: white;
        padding: 55px 20px;
        margin-bottom: 40px;
        border-radius: 0 0 30px 30px;
    }

        .teams-header h1 {
            font-size: 36px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .teams-header p {
            font-size: 16px;
            opacity: 0.9;
            margin-bottom: 0;
        }

    .teams-container {
        max-width: 1100px;
        margin: auto;
        padding-bottom: 50px;
    }

    .teams-count {
        color: var(--slate-navy);
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .team-card {
        background: white;
        border: 1px solid var(--dust-pink);
        border-radius: 18px;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .team-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 25px rgba(67, 67, 111, 0.13);
        }

    .team-card-top {
        height: 8px;
        background: linear-gradient(90deg, var(--berry-red), var(--pastel-pink));
    }

    .team-card-body {
        padding: 25px;
    }

    .team-icon {
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: #F8EAF0;
        color: var(--berry-red);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        margin-bottom: 18px;
    }

    .team-name {
        color: var(--slate-navy);
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 12px;
        overflow-wrap: anywhere;
    }

    .team-description {
        color: #777;
        font-size: 14px;
        line-height: 1.7;
        min-height: 48px;
        overflow-wrap: anywhere;
    }

    .team-divider {
        border: 0;
        border-top: 1px solid #EEE5E9;
        margin: 20px 0;
    }

    .team-owner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #F8F5F7;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .owner-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--pastel-pink);
        color: var(--slate-navy);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .owner-details small {
        display: block;
        color: #888;
        font-size: 11px;
    }

    .owner-details strong {
        color: var(--slate-navy);
        font-size: 14px;
    }

    .btn-view-team {
        display: block;
        width: 100%;
        background: var(--slate-navy);
        color: white;
        padding: 12px;
        border-radius: 9px;
        text-align: center;
        font-weight: 600;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .btn-view-team:hover {
            background: var(--berry-red);
            color: white;
            text-decoration: none;
        }

    .empty-state {
        background: white;
        border: 1px dashed var(--pastel-pink);
        border-radius: 20px;
        text-align: center;
        padding: 60px 20px;
        box-shadow: 0 5px 18px rgba(67, 67, 111, 0.05);
    }

    .empty-icon {
        font-size: 52px;
        margin-bottom: 18px;
    }

    .empty-state h4 {
        color: var(--slate-navy);
        font-weight: 700;
        margin-bottom: 12px;
    }

    .empty-state p {
        color: #777;
        margin-bottom: 0;
    }

    @@media (max-width: 767px) {
        .teams-header {
            padding: 40px 15px;
        }

            .teams-header h1 {
                font-size: 28px;
            }

        .team-card-body {
            padding: 20px;
        }
    }
</style>

<div class="teams-header text-center">
    <div class="container">
        <h1>👥 My Teams</h1>
        <p>View and manage the startup teams you own or belong to.</p>
    </div>
</div>

<div class="container teams-container">

    @if (Model != null && Model.Any())
    {
        <div class="teams-count">
            🚀 Your Teams
            <span style="color: var(--berry-red);">
                (@Model.Count())
            </span>
        </div>

        <div class="row">

            @foreach (var team in Model)
            {
                <div class="col-lg-6 col-md-6 mb-4">

                    <div class="team-card">

                        <div class="team-card-top"></div>

                        <div class="team-card-body">

                            <div class="team-icon">
                                👥
                            </div>

                            <h4 class="team-name">
                                @team.TeamName
                            </h4>

                            <p class="team-description">
                                @(string.IsNullOrWhiteSpace(team.Description)
                                    ? "No description has been added for this team yet."
                                    : team.Description)
                            </p>

                            <hr class="team-divider" />

                            <div class="team-owner">

                                <div class="owner-icon">
                                    👤
                                </div>

                                <div class="owner-details">
                                    <small>Team Owner ID</small>
                                    <strong>#@team.OwnerId</strong>
                                </div>

                            </div>

                            <a href="@Url.Action("Details", "Team", new { id = team.Id })"
                               class="btn-view-team">
                                👁 View Team Details →
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-state">

            <div class="empty-icon">
                🚀
            </div>

            <h4>No Teams Found</h4>

            <p>
                You have not joined or created any startup teams yet.
                Once you create a team or join one, it will appear here.
            </p>

        </div>
    }

</div>